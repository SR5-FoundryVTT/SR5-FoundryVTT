{{> "systems/shadowrun5e/dist/templates/v2/actor/parts/limits.hbs" }}

{{#if system.isSwarm}}
    <div class="list-item rigger-swarm-bar">
        {{#if @root.isEditMode}}
            <div class="list-item-start">
                <label><strong>{{localize "SR5.Swarm.Leader"}}:</strong></label>&nbsp;
                {{formInput systemFields.isSwarmLeader value=source.system.isSwarmLeader rootId=@root.rootId}}
            </div>
            {{#unless system.isSwarmLeader}}
                <div class="list-item-start">
                    <label><strong>{{localize "SR5.Swarm.SelectLeader"}}:</strong></label>&nbsp;
                    {{#if @root.eligibleSwarmLeaders}}
                        <select name="system.swarmLeaderUuid">
                            <option value="">—</option>
                            {{#each @root.eligibleSwarmLeaders}}
                                <option value="{{this.uuid}}" {{#if (eq this.uuid @root.source.system.swarmLeaderUuid)}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                    {{else}}
                        {{formInput systemFields.swarmLeaderUuid value=source.system.swarmLeaderUuid classes="short" rootId=@root.rootId}}
                    {{/if}}
                </div>
            {{/unless}}
        {{else}}
            <div class="list-item-start swarm-info-badges">
                {{#if system.isSwarmLeader}}
                    <span class="tag badge active" data-tooltip="SR5.Swarm.Leader">
                        <i class="fas fa-network-wired"></i> {{localize "SR5.Swarm.Active"}}
                    </span>
                {{else if system.swarmLeaderUuid}}
                    <span class="tag badge" data-tooltip="SR5.Swarm.Member">
                        <i class="fas fa-sitemap"></i> {{localize "SR5.Swarm.Member"}}
                    </span>
                {{/if}}
                <span class="tag badge" data-tooltip="SR5.Swarm.Drones">
                    <i class="fas fa-robot"></i> {{swarmInfo.memberCount}} {{localize "SR5.Swarm.Drones"}}
                </span>
                <span class="tag badge" data-tooltip="SR5.Bonus">
                    <i class="fas fa-plus"></i> {{swarmInfo.bonus}} {{localize "SR5.Bonus"}}
                </span>
                {{#if swarmInfo.swarmPilot}}
                    <span class="tag badge" data-tooltip="SR5.Vehicle.Stats.Pilot">
                        <i class="fas fa-brain"></i> {{localize "SR5.Vehicle.Stats.Pilot"}}: {{swarmInfo.swarmPilot}}
                    </span>
                {{/if}}
            </div>
        {{/if}}
    </div>
{{/if}}

{{#if autosoftInfo.isOverSlots}}
    <div class="list-item warning-banner" style="background-color: rgba(255, 165, 0, 0.2); padding: 4px 8px; border: 1px solid orange; border-radius: 4px; margin-bottom: 4px;">
        <i class="fas fa-triangle-exclamation" style="color: orange; margin-right: 6px;"></i>
        <span>{{localize "SR5.Warnings.OverAutosoftSlots"}} ({{autosoftInfo.runningCount}} / {{autosoftInfo.maxSlots}})</span>
    </div>
{{/if}}

<div class="attributes">
    {{#if @root.isEditMode}}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/vehicle-paired-attribute.hbs"
            label="SR5.Vehicle.Stats.Handling"
            onRoadAttribute=system.vehicle_stats.handling
            onRoadField=systemFields.vehicle_stats.fields.handling
            offRoadAttribute=system.vehicle_stats.off_road_handling
            offRoadField=systemFields.vehicle_stats.fields.off_road_handling
            isOffRoad=system.isOffRoad
        }}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/vehicle-paired-attribute.hbs"
            label="SR5.Vehicle.Stats.Speed"
            onRoadAttribute=system.vehicle_stats.speed
            onRoadField=systemFields.vehicle_stats.fields.speed
            offRoadAttribute=system.vehicle_stats.off_road_speed
            offRoadField=systemFields.vehicle_stats.fields.off_road_speed
            isOffRoad=system.isOffRoad
        }}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/vehicle-paired-attribute.hbs"
            label="SR5.Vehicle.Stats.Acceleration"
            onRoadAttribute=system.vehicle_stats.acceleration
            onRoadField=systemFields.vehicle_stats.fields.acceleration
            offRoadAttribute=system.vehicle_stats.off_road_acceleration
            offRoadField=systemFields.vehicle_stats.fields.off_road_acceleration
            isOffRoad=system.isOffRoad
        }}
    {{else}}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/vehicle-paired-attribute.hbs"
            label="SR5.Vehicle.Stats.Handling"
            onRoadAttribute=system.vehicle_stats.handling
            onRoadField=systemFields.vehicle_stats.fields.handling
            offRoadAttribute=system.vehicle_stats.off_road_handling
            offRoadField=systemFields.vehicle_stats.fields.off_road_handling
            isOffRoad=system.isOffRoad
            cssClass=(ifThen (eq system.environment 'speed') 'vehicle-environment-inactive' '')
        }}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/vehicle-paired-attribute.hbs"
            label="SR5.Vehicle.Stats.Speed"
            onRoadAttribute=system.vehicle_stats.speed
            onRoadField=systemFields.vehicle_stats.fields.speed
            offRoadAttribute=system.vehicle_stats.off_road_speed
            offRoadField=systemFields.vehicle_stats.fields.off_road_speed
            isOffRoad=system.isOffRoad
            cssClass=(ifThen (eq system.environment 'handling') 'vehicle-environment-inactive' '')
        }}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/vehicle-paired-attribute.hbs"
            label="SR5.Vehicle.Stats.Acceleration"
            onRoadAttribute=system.vehicle_stats.acceleration
            onRoadField=systemFields.vehicle_stats.fields.acceleration
            offRoadAttribute=system.vehicle_stats.off_road_acceleration
            offRoadField=systemFields.vehicle_stats.fields.off_road_acceleration
            isOffRoad=system.isOffRoad
        }}
    {{/if}}
    {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/attribute.hbs"
        attribute=system.attributes.body
        attributeField=systemFields.attributes.fields.body
    }}
    {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/attribute.hbs"
        label="SR5.Armor.label"
        attribute=system.armor.rating
        attributeField=systemFields.armor.fields.rating
        modifierTooltipPath="armor.rating"
    }}
    {{#unless system.vehicle_stats.pilot.hidden}}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/attribute.hbs"
            attribute=system.vehicle_stats.pilot
            attributeField=systemFields.vehicle_stats.fields.pilot
        }}
    {{/unless}}
    {{#unless system.vehicle_stats.sensor.hidden}}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/attribute.hbs"
            attribute=system.vehicle_stats.sensor
            attributeField=systemFields.vehicle_stats.fields.sensor
        }}
    {{/unless}}
    {{#unless system.vehicle_stats.seats.hidden}}
        {{> "systems/shadowrun5e/dist/templates/v2/actor/parts/attribute.hbs"
            attribute=system.vehicle_stats.seats
            attributeField=systemFields.vehicle_stats.fields.seats
        }}
    {{/unless}}
</div>
