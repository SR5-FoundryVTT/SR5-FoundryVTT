<div class="list-item list-item-header {{cssClass}}">
    <div class="list-item-start">
        <label class="item-text item-name">{{localize label}}</label>
    </div>
    <div class="list-item-icons">
        <a data-action="toggleInventoryVisibility" data-type="{{type}}">
            <i class="fas {{#if isOpen}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
        </a>
    </div>
</div>
