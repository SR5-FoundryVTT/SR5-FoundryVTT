<div class="list-item list-item-header {{cssClass}} {{#if @root.isPlayMode}} collapsible-header{{/if}}"
    {{#unless @root.isEditMode}}
     data-action="toggleExpanded"
     data-item-type="{{type}}"
    {{/unless}}>
    <div class="list-item-start{{#unless isOpen}} label-collapsed{{/unless}}">
        <label>
            {{localize label}}
        </label>
    </div>

    <div class="list-item-col thicc-col">
        <label>{{localize "SR5.Item.Labels.MountPoint"}}</label>
    </div>
    <div class="list-item-col skinny-col">
        <label>{{localize "SR5.DP"}}</label>
    </div>
    <div class="list-item-col skinny-col">
        <label data-tooltip="{{localize "SR5.Weapon.Labels.Accuracy"}}"><i class="fas fa-crosshairs-simple"></i></label>
    </div>
    <div class="list-item-col skinny-col">
        <label>{{localize "SR5.Weapon.Labels.RecoilCompensation"}}</label>
    </div>
    <div class="list-item-col skinny-col">
        <label data-tooltip="{{localize "SR5.Item.Labels.Conceal"}}"><i class="fas fa-magnifying-glass"></i></label>
    </div>

    <div class="list-item-icons">
        {{> "systems/shadowrun5e/dist/templates/v2/list-items/header-add-icon.hbs" type=type }}
    </div>
</div>
