{{!-- Rows shared by modifier tooltips and inline panels. --}}
{{#if (or (not card) value.base)}}
    <div class="list-item">
        <div class="value-modifier-name">
            <label>{{localize 'SR5.BaseValue'}}</label>
        </div>
        <div class="value-modifiers-base">
            <label>{{value.base}}</label>
        </div>
    </div>
{{/if}}
{{#each value.changes as |change|}}
    {{!-- Link traced changes to their nested breakdowns. --}}
    <div class="list-item{{#if (lookup ../traceSources @index)}} has-tooltip{{/if}}"
         {{#if (lookup ../traceSources @index)}}data-tooltip-source="{{lookup ../traceSources @index}}"{{/if}}>
        <div class="value-modifier-name {{getChangeCSS change}}">
            <label>{{localize change.name}}</label>
        </div>
        <div class="value-modifiers-modifier {{getChangeCSS change}}">
            <label>{{getChangeValue change}}</label>
        </div>
    </div>
{{/each}}
