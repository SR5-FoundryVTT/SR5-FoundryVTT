{{#if @root.isEditMode}}
    <div class="basic-row">
        <label data-tooltip="{{systemFields.subtype.hint}}">{{localize "SR5.Metatype.Category"}}</label>
        <span>
            <input type="text" name="system.subtype" class="short" value="{{system.subtype}}" data-tooltip="{{localize 'SR5.Metatype.Category'}}" />
        </span>
    </div>
    <div class="basic-row">
        <label data-tooltip="{{systemFields.subsubtype.hint}}">{{localize "SR5.Metatype.Subsubtype"}}</label>
        <span>
            <input type="text" name="system.subsubtype" class="short" value="{{system.subsubtype}}" data-tooltip="{{localize 'SR5.Metatype.Subsubtype'}}" />
        </span>
    </div>
    <div class="basic-row">
        <label data-tooltip="{{systemFields.karma.hint}}">{{localize "SR5.Karma"}}</label>
        <span>
            <input type="number" name="system.karma" value="{{source.system.karma}}" class="short skinny" min="0" />
        </span>
    </div>
{{else}}
    <label data-tooltip="{{localize 'SR5.Metatype.Category'}}">{{localizeSubtype system.subtype}}</label>
    {{#if (ne system.subsubtype "")}}
        <label data-tooltip="{{localize 'SR5.Metatype.Subsubtype'}}">{{localizeSubsubtype system.subsubtype}}</label>
    {{/if}}
    <label data-tooltip="{{localize 'SR5.Metatype.KarmaCost'}}">{{localize "SR5.Karma"}}&nbsp;{{system.karma}}</label>
{{/if}}
