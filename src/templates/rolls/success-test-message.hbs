<div class="sr5 chat-card roll-card sr5-roll-card-v2">
    <div class="card-title card-header card-header--title">
        <span class="test-name">{{localize title}}</span>
        {{#if showDescription}}
        <span class="card-control clickable show-description">
            <i class="fa-solid fa-file-lines"></i>
        </span>
        {{/if}}
    </div>
    {{#if (or speaker.source item)}}
    <div class="card-title card-header card-header--entities">
        <div class="container container--fluid">
            <div class="container__row">
                {{#if speaker.source}}
                <div class="container__col">
                    <div class="document">
                        {{!-- TODO: token id handling, why not uuid? ??? --}}
                        <a class="chat-select-link" data-token-id="{{speaker.token.id}}">
                            <img src="{{speakerImg speaker.source}}" class="entity-selectable" data-tooltip="{{speakerName speaker.source}}" />
                        </a>
                        <h3 class="header-name">
                            <a class="chat-document-link" data-uuid="{{speaker.source.uuid}}">{{speakerName speaker.source}}</a>
                        </h3>
                    </div>
                </div>
                {{/if}}
                {{#if item}}
                <div class="container__col container__col--item">
                    <div class="document">
                        <a class="chat-document-link" data-entity="Item" data-id="{{item.id}}" data-uuid="{{item.uuid}}">
                            <img src="{{item.img}}" data-tooltip="{{localizeContent item.name}}" />
                        </a>
                        {{!-- An action item usually carries the test's own name; the icon alone says it. --}}
                        {{#ifne (localizeContent item.name) (localize title)}}
                        <h3 class="header-name">
                            <a class="chat-document-link" data-entity="Item" data-id="{{item.id}}" data-uuid="{{item.uuid}}">{{localizeContent item.name}}</a>
                        </h3>
                        {{/ifne}}
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    {{/if}}
    <div class="card-main-content">
        {{#if test.hasAction}}
        <div class="card-content card-content--code {{#if applyGmOnlyContent}}gm-only-content{{/if}}">
            <div class="test-line">
                <span class="test-code">
                    {{#if test.codeTerms.pool.length}}
                        {{> 'systems/shadowrun5e/dist/templates/rolls/parts/test-code-terms.hbs' terms=test.codeTerms.pool}}
                    {{else}}
                        <span class="test-code-term">{{test.pool.value}}</span>
                    {{/if}}
                    {{#if (and test.hasLimit test.codeTerms.limit.length)}}
                        [{{> 'systems/shadowrun5e/dist/templates/rolls/parts/test-code-terms.hbs' terms=test.codeTerms.limit}}]
                    {{/if}}
                    {{#if (and test.hasThreshold test.codeTerms.threshold.length)}}
                        ({{> 'systems/shadowrun5e/dist/templates/rolls/parts/test-code-terms.hbs' terms=test.codeTerms.threshold}})
                    {{/if}}
                </span>
            </div>
        </div>
        {{/if}}
        {{#unless test.autoSuccess}}
        {{!-- Resolved pool, limit, and threshold values. --}}
        <div class="card-content card-content--parameters {{#if applyGmOnlyContent}}gm-only-content{{/if}}">
            {{#each test.cardParameters as |parameter|}}
            <span class="test-parameter" data-tooltip-source="{{parameter.source}}"
                  role="button" tabindex="0" aria-expanded="false">
                <span class="test-parameter-content">
                    <span class="test-parameter-label">{{localize parameter.value.label}}</span>
                    <span class="test-parameter-value">{{parameter.value.value}}</span>
                </span>
            </span>
            {{/each}}
            {{! Modifier breakdowns are added during hydration. }}
            <div class="test-parameter-details"></div>
        </div>
        <div class="card-content card-content--metrics {{#if showDescription}}show-description{{/if}} {{#if applyGmOnlyContent}}gm-only-content{{/if}}">
            <div class="left-side">
                {{#if test.opposing}}
                <div class="test-value metric-row">
                    <span class="value">{{localize "SR5.OpposingHits"}}:</span>
                    <span class="value-result">{{test.against.netHits.value}}</span>
                </div>
                {{/if}}
                {{! Extended tests show current hits opposite accumulated net hits. }}
                {{#if test.extended}}
                <div class="test-value metric-row">
                    <span class="value">{{localize test.hits.label}}:</span>
                    <span class="value-result">
                        {{test.hitsBreakdown}}
                    </span>
                </div>
                {{/if}}
                {{#if previewTemplate}}
                <div class="test-value metric-row metric-row--template">
                    <span class="value" data-tooltip="SR5.PlaceTemplate">{{localize "SR5.PlaceTemplate"}}:</span>
                    <span class="value-result"><i class="fas fa-bullseye roll place-template"></i></span>
                </div>
                {{/if}}
            </div>
            <div class="right-side">
                {{#if test.opposing}}
                <div class="test-value metric-row">
                    <span class="value">{{localize "SR5.OpposingNetHits"}}:</span>
                    <span class="value-result">{{test.againstNetHits.value}}</span>
                </div>
                {{/if}}
                {{#if (and (not test.opposing) test.hasThreshold)}}
                <div class="test-value metric-row">
                    <span class="value">{{localize test.netHits.label}}:</span>
                    <span class="value-result">{{test.netHits.value}}</span>
                </div>
                {{/if}}
            </div>
        </div>
        {{#if showDescription}}
        <div class="card-description">
            {{#if description.description.value}}
            <div class="card-description-content">
                {{{description.description.value}}}
            </div>
            {{/if}}
            <div class="card-description-tags">
                {{#each description.properties}}
                <span>{{this}}</span>
                {{/each}}
            </div>
        </div>
        {{/if}}
        {{/unless}}
        {{#if (and test.data.incomingDamage test.data.modifiedDamage)}}
        <div class="card-content card-content--damage">
            <div class="left-side">
                {{> 'systems/shadowrun5e/dist/templates/rolls/parts/DamagePair.hbs'
                label=(localize "SR5.Damage")
                incomingName=(localize "SR5.Incoming")
                incomingDamage=test.data.incomingDamage
                modifiedName=(localize "SR5.Modified")
                modifiedDamage=test.data.modifiedDamage
                showAP=(or (eq test.data.type 'PhysicalDefenseTest') (eq test.data.type 'SuppressionDefenseTest'))
                }}
            </div>
        </div>
        {{else if (and test.data.incomingDrain test.data.modifiedDrain)}}
        <div class="card-content card-content--damage">
            <div class="left-side">
                {{> 'systems/shadowrun5e/dist/templates/rolls/parts/DamagePair.hbs'
                label=(localize "SR5.Damage")
                incomingName=(localize "SR5.IncomingDrain")
                incomingDamage=test.data.incomingDrain
                modifiedName=(localize "SR5.ModifiedDrain")
                modifiedDamage=test.data.modifiedDrain
                showAP=false
                }}
            </div>
        </div>
        {{else if (and test.data.incomingFade test.data.modifiedFade)}}
        <div class="card-content card-content--damage">
            <div class="left-side">
                {{> 'systems/shadowrun5e/dist/templates/rolls/parts/DamagePair.hbs'
                label=(localize "SR5.Damage")
                incomingName=(localize "SR5.IncomingFade")
                incomingDamage=test.data.incomingFade
                modifiedName=(localize "SR5.ModifiedFade")
                modifiedDamage=test.data.modifiedFade
                showAP=false
                }}
            </div>
        </div>
        {{else if test.data.drainDamage}}
        <div class="card-content card-content--damage">
            <div class="left-side">
                {{> 'systems/shadowrun5e/dist/templates/rolls/parts/Damage.hbs'
                name=(localize "SR5.IncomingDrain")
                tooltip=(localize "SR5.IncomingDrain")
                damage=test.data.drainDamage
                showAP=true
                }}
            </div>
        </div>
        {{else if test.data.fadeDamage}}
        <div class="card-content card-content--damage">
            <div class="left-side">
                {{> 'systems/shadowrun5e/dist/templates/rolls/parts/Damage.hbs'
                name=(localize "SR5.IncomingFade")
                tooltip=(localize "SR5.IncomingFade")
                damage=test.data.fadeDamage
                showAP=true
                }}
            </div>
        </div>
        {{else}}
            {{#if test.data.damage}}
                {{#if test.hasDamage}}
                <div class="card-content card-content--damage">
                    <div class="left-side">
                        {{> 'systems/shadowrun5e/dist/templates/rolls/parts/Damage.hbs'
                        name=(localize "SR5.Damage")
                        tooltip=(localize "SR5.Incoming")
                        damage=test.data.damage
                        showAP=true
                        }}
                    </div>
                </div>
                {{/if}}
            {{/if}}
        {{/if}}
        <div class="card-test-content card-test-content--status">
            {{! Hits, the verdict and the glitched state share one band. The test decides what it can name. }}
            {{#if test.showsOutcome}}
            <div class="glitch-content {{#unless test.autoSuccess}}clickable show-roll{{/unless}} {{#if test.criticalGlitched}}glitch-content--critical{{else if test.glitched}}glitch-content--warning{{/if}}">
                <div class="test-outcome">
                    {{#unless test.autoSuccess}}{{#if test.hasBuyHits}}<i class="test-outcome-bought-hits fa-solid fa-coins" role="img" data-tooltip="SR5.HitsBought" aria-label="{{localize 'SR5.HitsBought'}}"></i>{{/if}}<span class="test-outcome-hits" data-tooltip-source="hits"><span class="test-outcome-hits-value">{{test.outcomeHits.value}}</span> {{localize test.outcomeHits.label}}</span>{{/unless}}
                    {{#if test.outcomeLabel}}
                    <span class="glitch" {{#if (and showGlitchAnimation test.criticalGlitched)}} data-glitch="{{localize test.outcomeLabel}}" {{/if}}>{{localize test.outcomeLabel}}</span>
                    {{/if}}
                    {{#if (and test.glitched (not test.criticalGlitched))}}
                    <span class="glitch" {{#if showGlitchAnimation}} data-glitch="{{localize 'SR5.Glitch'}}" {{/if}}>{{localize "SR5.Glitch"}}</span>
                    {{/if}}
                </div>
            </div>
            {{/if}}
        </div>
        <div class="card-rolls {{#if applyGmOnlyContent}}gm-only-content{{/if}}">
            {{#if test.hasBuyHits}}
                <div class="dice-roll-content dice-roll-content--bought-hits">
                    {{localize "SR5.HitsBought"}}
                </div>
            {{else}}
                {{#each test.rolls}}
                    {{> 'systems/shadowrun5e/dist/templates/rolls/parts/rolled-dice.hbs'
                    roll=this
                    }}
                {{/each}}
            {{/if}}
        </div>
        {{#if test.data.knockedDown}}
        <div class="card-content card-content--knockdown">
            <div class="left-side">
                <div class="limit-line">
                    <span class="key">{{localize "SR5.Target"}}: </span>
                    <span class="value">{{localize "SR5.KnockedDown"}}</span>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
    {{#if test.targets}}
    <div class="test-line test-line--targets">
        <span class="test-name {{#if roll}}test-roll{{/if}}">
            {{localize "SR5.SelectedTargets"}}
        </span>
    </div>
    <div class="card-title card-header card-header--targets">
        <div class="container container--fluid">
            {{#each test.targets}}
            <div class="container__row">
                <div class="container__col">
                    <div class="document">
                        <a class="chat-select-link" data-token-id="{{this.id}}">
                            <img src="{{speakerImg this}}" class="entity-selectable" data-tooltip="SR5.Labels.Message.ClickToSelect" />
                        </a>
                        <h3 class="header-name">
                            <a class="chat-document-link" data-uuid="{{this.uuid}}">{{speakerName this}}</a>
                        </h3>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
    {{#if test.opposed}}
    <div class="card-buttons card-buttons--actions">
        {{#each opposedActions}}
        <div class="button opposed-action" data-action="{{this.test}}">
            {{localize this.label}} {{#if ../test.data.opposed.mod}}{{../test.data.opposed.mod}}{{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{#if followupActions}}
    <div class="card-buttons card-buttons--actions">
        {{#each followupActions}}
        <div class="button followup-action">
            {{localize this.label}}
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{#if resistActions}}
    <div class="card-buttons card-buttons--actions">
        {{#each resistActions}}
        <div class="button resist-action" data-action="{{this.test}}">
            {{localize this.label}}
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{#if resultActions}}
    <div class="card-content card-content--results">
        <div class="left-side">
            {{#each resultActions}}
            <div class="test-value metric-row">
                <span class="value">{{localize this.label}}:</span>
                <span class="value-result">
                    <span class="button result-action" data-action="{{this.action}}">{{signedValue this.value}}</span>
                </span>
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
</div>
