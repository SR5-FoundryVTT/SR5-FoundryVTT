<div class="card-buttons card-buttons--actions sr5-flow-steps sr5-flow-apply">
    {{#each rows}}
    <div class="sr5-flow-step">
        <a class="sr5-flow-step__subject chat-document-link" data-uuid="{{this.subjectUuid}}">{{this.name}}</a>
        {{#if this.isPending}}
            {{#if this.canExecute}}
            <div class="button flow-apply-action" data-step-id="{{this.stepId}}" data-subject-uuid="{{this.subjectUuid}}">
                {{localize this.label}}{{#if this.damage}} {{damageCode this.damage}}{{/if}}
            </div>
            {{else}}
            <span class="sr5-flow-step__status">{{localize this.label}}: {{localize "SR5.Flow.Pending"}}</span>
            {{/if}}
        {{else}}
        <span class="sr5-flow-step__status">{{localize this.label}}{{#if this.damage}} {{damageCode this.damage}}{{/if}}: {{localize "SR5.Flow.Applied"}}</span>
        {{/if}}
    </div>
    {{/each}}
</div>
