<div class="dialog-content-common">
    {{#if test.hasCode}}
    <hr/>
    <div class="common-test">
        <span class="test-code">
            {{#if test.codeTerms.pool.length}}
                {{> 'systems/shadowrun5e/dist/templates/rolls/parts/test-code-terms.hbs' terms=test.codeTerms.pool detailed=true}}
            {{else}}
                <span class="test-code-term">{{test.pool.value}}</span>
            {{/if}}
            {{#if (and test.hasLimit test.codeTerms.limit.length)}}
                [{{> 'systems/shadowrun5e/dist/templates/rolls/parts/test-code-terms.hbs' terms=test.codeTerms.limit detailed=true}}]
            {{/if}}
            {{! The dialog keeps a zero threshold visible, as it shows the value next to the name. }}
            {{#if test.codeTerms.threshold.length}}
                ({{> 'systems/shadowrun5e/dist/templates/rolls/parts/test-code-terms.hbs' terms=test.codeTerms.threshold detailed=true}})
            {{/if}}
        </span>
    </div>
    {{/if}}

    <hr/>
    <div>
        {{! --- Dice Pool --- }}
        {{> "systems/shadowrun5e/dist/templates/apps/dialogs/parts/success-test-entry.hbs"
            path="test.data.pool"
            data=test.data.pool
            label="SR5.DicePool"
            tooltip="SR5.Tooltips.Test.Pool"
        }}
        {{! --- Limit --- }}
        {{> "systems/shadowrun5e/dist/templates/apps/dialogs/parts/success-test-entry.hbs"
            path="test.data.limit"
            data=test.data.limit
            label="SR5.Limit"
            tooltip="SR5.Tooltips.Test.Limit"
            usage=test.limitUsage
        }}
        {{! --- Threshold --- }}
        {{> "systems/shadowrun5e/dist/templates/apps/dialogs/parts/success-test-entry.hbs"
            path="test.data.threshold"
            data=test.data.threshold
            label="SR5.Threshold"
            tooltip="SR5.Tooltips.Test.Threshold"
            usage=test.thresholdUsage
        }}
    </div>

    <hr/>
    <div class="modify-roll-section {{#if (includes expandedPaths 'modify-roll')}}expanded{{/if}}" data-section="modify-roll">
        <div class="modify-roll-header">
            <label class="modify-roll-title">{{localize "SR5.ModifyRoll"}}</label>
            <a class="toggle-modify-roll" title="{{localize 'SR5.ToggleSection'}}">
                <i class="fas fa-chevron-up"></i>
            </a>
        </div>

        <div class="modify-roll-content">
            <div class="form-group toggle-checkbox-row">
                <label data-tooltip="SR5.Tooltips.Test.BuyHits">{{localize "SR5.BuyHits"}}</label>
                <input type="checkbox" name="test.data.buyHits" {{#if test.hasBuyHits}}checked{{/if}} />
            </div>

            {{#if test.actor}}
            <div class="form-group toggle-checkbox-row">
                <label data-tooltip="SR5.Tooltips.Test.PushTheLimit">{{localize "SR5.PushTheLimit"}}
                    ({{test.actor.system.attributes.edge.uses}}/{{test.actor.system.attributes.edge.value}})</label>
                <input type="checkbox" name="test.data.pushTheLimit" {{#if test.hasPushTheLimit}}checked{{/if}}/>
            </div>
            {{/if}}

            {{#if test.canBeExtended}}
            <div class="form-group extended-interval-row">
                <label data-tooltip="SR5.Tooltips.Test.Extended">{{localize "SR5.Extended"}}</label>
                <div class="duration-control-fields duration-value-fields extended-interval-fields">
                    <input type="number" name="test.data.extendedInterval.value"
                        value="{{test.data.extendedInterval.value}}" min="0" step="1"
                        data-tooltip="SR5.Tooltips.Test.ExtendedInterval"
                        aria-label="{{localize 'SR5.ExtendedTestManager.Interval'}}"/>
                    {{> 'systems/shadowrun5e/dist/templates/apps/partials/interval-units.hbs'
                        name="test.data.extendedInterval.unit"
                        selected=test.data.extendedInterval.unit
                        label=(localize 'SR5.ActiveEffect.Duration.Units')}}
                </div>
            </div>
            {{/if}}

            <div class="form-group">
                <label data-tooltip="SR5.Tooltips.Test.RollMode">{{ localize "SR5.RollMode" }}</label>
                <select style="color: white" name="test.data.options.rollMode">
                    {{selectOptions rollModes selected=rollMode labelAttr="label" localize=true}}
                </select>
            </div>
        </div>
    </div>
</div>
