<form>
    <div class="dialog-content-common">
        {{> 'systems/shadowrun5e/dist/templates/apps/dialogs/parts/success-test-documents.hbs'}}
        <hr />
        <div>
            {{!-- Force and potency come from the preparation itself and can't be chosen. SR5#306 --}}
            <div class="form-group">
                <label data-tooltip="SR5.Tooltips.Preparation.Force">{{localize "SR5.Force"}}</label>
                <input disabled type="number" class="disabled-for-display" value="{{test.data.force}}" />
            </div>
            <div class="form-group">
                <label data-tooltip="SR5.Tooltips.Preparation.Potency">{{localize "SR5.Preparation.Potency"}}</label>
                <input disabled type="number" class="disabled-for-display" value="{{test.data.potency}}" />
            </div>
            <div class="form-group">
                <label data-tooltip="SR5.Tooltips.Preparation.Trigger">{{localize "SR5.Preparation.FIELDS.trigger.label"}}</label>
                <input disabled type="text" class="disabled-for-display text-value" value="{{localizeOb test.item.system.trigger @root.config.preparationTriggers}}" />
            </div>
        </div>
    </div>
    <div>
        {{> 'systems/shadowrun5e/dist/templates/apps/dialogs/parts/success-test-common.hbs'}}
    </div>
</form>
