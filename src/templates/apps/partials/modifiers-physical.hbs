<table>
    <tr class="env-modifier-category">
            <th>{{localize "SR5.EnvModifiersApplication.Visibility.Title"}}</th>
            <th>{{localize "SR5.EnvModifiersApplication.LightGlare.Title"}} <i class="fa-solid fa-circle-info env-modifier-hint" data-tooltip="SR5.EnvModifiersApplication.LightGlare.Hint"></i></th>
            <th>{{localize "SR5.EnvModifiersApplication.Wind.Title"}}</th>
            <th>{{localize "SR5.EnvModifiersApplication.Modifier.Title"}}</th>
        </tr>
        <tr class="env-modifier-category">
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'visibility' modifiers.environmental.levels.good)}}env-modifier-active{{/if}}" data-category="visibility" data-value="{{modifiers.environmental.levels.good}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Visibility.Good"}}</button></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (and (IsEnvModifierActive modifiers.environmental.applied.active 'light' modifiers.environmental.levels.good) (not modifiers.environmental.applied.active.glare))}}env-modifier-active{{/if}}" data-category="light" data-value="{{modifiers.environmental.levels.good}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.LightGlare.Good"}}</button></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'wind' modifiers.environmental.levels.good)}}env-modifier-active{{/if}}" data-category="wind" data-value="{{modifiers.environmental.levels.good}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Wind.Good"}}</button></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'value' modifiers.environmental.levels.good)}}env-modifier-active{{/if}}" data-category="value" data-value="{{modifiers.environmental.levels.good}}" {{#if disableForm}}disabled{{/if}}>{{modifiers.environmental.levels.good}}</button></td>
        </tr>
        <tr class="env-modifier-category">
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'visibility' modifiers.environmental.levels.light)}}env-modifier-active{{/if}}" data-category="visibility" data-value="{{modifiers.environmental.levels.light}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Visibility.Light"}}</button></td>
            <td class="env-modifier-level"><div class="env-modifier-split"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'light' modifiers.environmental.levels.light)}}env-modifier-active{{/if}}" data-category="light" data-value="{{modifiers.environmental.levels.light}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Light.Light"}}</button><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'glare' modifiers.environmental.levels.light)}}env-modifier-active{{/if}}" data-category="glare" data-value="{{modifiers.environmental.levels.light}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Glare.Light"}}</button></div></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'wind' modifiers.environmental.levels.light)}}env-modifier-active{{/if}}" data-category="wind" data-value="{{modifiers.environmental.levels.light}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Wind.Light"}}</button></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'value' modifiers.environmental.levels.light)}}env-modifier-active{{/if}}" data-category="value" data-value="{{modifiers.environmental.levels.light}}" {{#if disableForm}}disabled{{/if}}>{{modifiers.environmental.levels.light}}</button></td>
        </tr>
        <tr class="env-modifier-category">
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'visibility' modifiers.environmental.levels.moderate)}}env-modifier-active{{/if}}" data-category="visibility" data-value="{{modifiers.environmental.levels.moderate}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Visibility.Moderate"}}</button></td>
