            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'wind' modifiers.environmental.levels.moderate)}}env-modifier-active{{/if}}" data-category="wind" data-value="{{modifiers.environmental.levels.moderate}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Wind.Moderate"}}</button></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'value' modifiers.environmental.levels.moderate)}}env-modifier-active{{/if}}" data-category="value" data-value="{{modifiers.environmental.levels.moderate}}" {{#if disableForm}}disabled{{/if}}>{{modifiers.environmental.levels.moderate}}</button></td>
        </tr>
        <tr class="env-modifier-category">
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'visibility' modifiers.environmental.levels.heavy)}}env-modifier-active{{/if}}" data-category="visibility" data-value="{{modifiers.environmental.levels.heavy}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Visibility.Heavy"}}</button></td>
            <td class="env-modifier-level"><div class="env-modifier-split"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'light' modifiers.environmental.levels.heavy)}}env-modifier-active{{/if}}" data-category="light" data-value="{{modifiers.environmental.levels.heavy}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Light.Heavy"}}</button><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'glare' modifiers.environmental.levels.heavy)}}env-modifier-active{{/if}}" data-category="glare" data-value="{{modifiers.environmental.levels.heavy}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Glare.Heavy"}}</button></div></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'wind' modifiers.environmental.levels.heavy)}}env-modifier-active{{/if}}" data-category="wind" data-value="{{modifiers.environmental.levels.heavy}}" {{#if disableForm}}disabled{{/if}}>{{localize "SR5.EnvModifiersApplication.Wind.Heavy"}}</button></td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'value' modifiers.environmental.levels.heavy)}}env-modifier-active{{/if}}" data-category="value" data-value="{{modifiers.environmental.levels.heavy}}" {{#if disableForm}}disabled{{/if}}>{{modifiers.environmental.levels.heavy}}</button></td>
        </tr>
        <tr class="env-modifier-category">
            <td colspan="3">{{localize "SR5.EnvModifiersApplication.Extreme"}}</td>
            <td class="env-modifier-level"><button type="button" data-action="toggleEnvironmentalModifier" class="env-modifier {{#if (IsEnvModifierActive modifiers.environmental.applied.active 'value' modifiers.environmental.levels.extreme)}}env-modifier-active{{/if}}" data-category="value" data-value="{{modifiers.environmental.levels.extreme}}" {{#if disableForm}}disabled{{/if}}>{{modifiers.environmental.levels.extreme}}</button></td>
        </tr>
        <tr class="env-modifier-category">
            <td colspan="2"></td>
            <td class="env-modifier-total">{{localize "SR5.EnvModifiersApplication.Total"}}</td>
            <td class="">{{modifiers.environmental.total}}</td>
        </tr>
</table>